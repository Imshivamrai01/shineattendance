# MongoDB (primary source of truth)
MONGODB_URI=mongodb://127.0.0.1:27017/shine_attendance

# Initial admin, used ONLY by `npm run seed:admin`. Never commit real values.
ADMIN_EMAIL=admin@shineinfo.in
ADMIN_INITIAL_PASSWORD=change-this-password

# Session lifetime in hours
SESSION_HOURS=8

# Google Sheets is connected from Settings in the app (Apps Script), no env variables needed.

# Cloudinary (attendance photos, captured live from the camera)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail SMTP with an App Password)
SMTP_USER=
SMTP_PASS= 
SMTP_FROM="Shine Attendance <hrjunecoinfotech@gmail.com>"
APP_URL=http://localhost:3000
CRON_SECRET=
