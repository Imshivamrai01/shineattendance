{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Staging voice engine for the CRM "Talk to it" live test: Deepgram -> Groq -> Rumik over one WebSocket.
  "name": "shine-voice-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws", "/api/*", "/vobiz/*"] },
  "durable_objects": { "bindings": [{ "name": "SESSION", "class_name": "VoiceSession" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceSession"] }],
  "workers_dev": true,
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "RUMIK_GATEWAY_URL": "https://silk-api.rumik.ai",
    "RUMIK_MODEL": "mulberry",
    "RUMIK_DESCRIPTION": "a warm, friendly Indian female receptionist voice, clear Hinglish",
    "BUSINESS_NAME": "Shine Infosolutions",
    "BUSINESS_INFO": "",
    "PUBLIC_URL": "https://shine-voice-staging.shineinfosolutions1.workers.dev",
    "VOBIZ_NUMBER": "+918065354620",
    "CALL_TIME_LIMIT_SEC": "300",
    "CRM_WEBHOOK_URL": "https://shine-attendance-staging.shineinfosolutions1.workers.dev/api/ai/webhook"
  },
  // Secrets (wrangler secret put): DEEPGRAM_API_KEY, GROQ_API_KEY, RUMIK_API_KEY, STAGING_TOKEN,
  // VOBIZ_AUTH_ID, VOBIZ_AUTH_TOKEN, CRM_WEBHOOK_SECRET (same value as AI_WEBHOOK_SECRET in the CRM)
  "observability": { "enabled": true },
  "env": {
    // Live voice engine for attendance.shineinfosolutions.in: wrangler deploy --env production (own secrets, own sessions).
    "production": {
      "name": "shine-voice",
      "durable_objects": { "bindings": [{ "name": "SESSION", "class_name": "VoiceSession" }] },
      "vars": {
        "GROQ_MODEL": "openai/gpt-oss-120b",
        "RUMIK_GATEWAY_URL": "https://silk-api.rumik.ai",
        "RUMIK_MODEL": "mulberry",
        "RUMIK_DESCRIPTION": "a warm, friendly Indian female receptionist voice, clear Hinglish",
        "BUSINESS_NAME": "Shine Infosolutions",
        "BUSINESS_INFO": "",
        "PUBLIC_URL": "https://shine-voice.shineinfosolutions1.workers.dev",
        "VOBIZ_NUMBER": "+918065354620",
        "CALL_TIME_LIMIT_SEC": "600",
        "CRM_WEBHOOK_URL": "https://attendance.shineinfosolutions.in/api/ai/webhook"
      }
    }
  }
}
